---
import { studio, studioTagline } from '../data/studio';
import { componentCounts } from '../data/components';
import { people } from '../data/members';
import { timeline } from '../data/timeline';

const totalPeople = people.reduce((sum, section) => sum + section.members.length, 0);

const contents = [
  {
    code: 'CMP',
    href: '/components',
    name: '组件档案',
    desc: `${componentCounts.total} 件组件 · ${componentCounts.listed} 件已上架 · ${componentCounts.byKind.length} 类形态`,
  },
  { code: 'COM', href: '/members', name: '社区网络', desc: `入口、成员与贡献者，共 ${totalPeople} 人收录` },
  { code: 'HIS', href: '/about', name: '我们的故事', desc: `${timeline.length} 个阶段，自 ${studio.foundedOn} 起` },
];
---

<article>
  <header class="shell plate masthead-plate">
    <div class="plate-head">
      <p class="label">EpochCraft Studio</p>
      <p class="label-cn">成立于 {studio.foundedOnLabel}</p>
    </div>

    <h1 class="wordmark">EPOCHCRAFT</h1>
    <p class="wordmark-zh">方块纪元工作室</p>

    <p class="lede">
      {studioTagline}
      组件覆盖{studio.craft}，已在中国版组件中心陆续上架；
      代码统一收纳在 GitHub 组织 {studio.org} 之下。
    </p>

    <dl class="tally">
      <div><dt>成立</dt><dd>{studio.foundedOn}</dd></div>
      <div><dt>组件</dt><dd>{componentCounts.total}</dd></div>
      <div><dt>已上架</dt><dd>{componentCounts.listed}</dd></div>
      <div><dt>成员</dt><dd>{totalPeople}</dd></div>
    </dl>
  </header>

  <section class="shell block">
    <div class="tick-rule" aria-hidden="true"></div>
    <div class="index-head"><p class="label">Contents</p></div>
    <ul class="tools">
      {contents.map((item) => (
        <li>
          <a href={item.href}>
            <span class="tool-code">{item.code}</span>
            <span class="tool-name">{item.name}</span>
            <span class="tool-desc">{item.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</article>

<style>
  .masthead-plate {
    padding-block: 80px 48px;
  }

  /* The pixel face at the one size where it genuinely belongs. */
  .wordmark {
    margin: 26px 0 0;
    font-family: var(--font-stamp);
    font-size: clamp(1.75rem, 7.5vw, 5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .wordmark-zh {
    margin: 14px 0 0;
    font-size: clamp(1rem, 2.4vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    color: var(--mark);
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 34px 0 0;
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }

  .tally div {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 28px 12px 0;
  }

  .tally dt {
    font-size: 0.75rem;
    color: var(--fg-3);
  }

  .tally dd {
    margin: 0;
    font-family: var(--font-data);
    font-size: 1rem;
    color: var(--fg);
  }
</style>
