---
import '../styles/institute.css';
import Daylight from '../components/Daylight.astro';
import { studio, studioTagline } from '../data/studio';

interface Props {
  title?: string;
  description?: string;
  /** Catalogue section stamped under the masthead, e.g. 'SRV'. */
  section?: string;
}

const {
  title = `${studio.nameZh}（${studio.org}） — ${studio.platform}工作室`,
  description = studioTagline,
  section = '',
} = Astro.props;

const navItems = [
  { href: '/components', label: '组件', code: 'CMP' },
  { href: '/members', label: '社区', code: 'COM' },
  { href: '/about', label: '故事', code: 'HIS' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

/** 规范链接以 `site` 为准，避免旧 GitHub Pages 域名被重复收录。 */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/imgs/logo.jpg" type="image/jpeg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${studio.nameZh}（${studio.nameEn}）`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+SC:wght@300;400;500;700;900&family=JetBrains+Mono:wght@400;500&family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body>
    <Daylight />

    <header class="masthead">
      <div class="shell masthead-inner">
        <a href="/" class="mark" aria-label="方块纪元工作室">
          <img src="/imgs/logo.jpg" alt="" width="18" height="18" />
          <span class="mark-zh">方块纪元工作室</span>
          <span class="mark-en">EPOCHCRAFT STUDIO</span>
        </a>

        <nav class="nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={currentPath === item.href.replace(/\/$/, '') ? 'nav-item is-active' : 'nav-item'}
            >
              <span class="nav-code">{item.code}</span>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
          <span class="nav-sep" aria-hidden="true"></span>
          <a href="https://github.com/EpochcraftMC" target="_blank" rel="noopener" class="nav-item">
            <span class="nav-code">GH</span>
            <span class="nav-label">GitHub</span>
          </a>
        </nav>
      </div>
      <div class="tick-rule" aria-hidden="true"></div>
      {section && (
        <div class="shell"><p class="section-stamp">档案 · {section}</p></div>
      )}
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <div class="tick-rule" aria-hidden="true"></div>
      <div class="shell colophon-inner">
        <div>
          <p class="label">Colophon</p>
          <p class="colophon-body">
            {studio.nameZh}（{studio.org}） — 成立于 {studio.foundedOnLabel}。<br />
            {studio.platform}的地图与皮肤创作工作室。
          </p>
          <p class="colophon-links">
            <a href="/components">组件档案</a>
            <a href="/members">社区网络</a>
            <a href="/about">故事</a>
          </p>
        </div>
        <dl class="colophon-meta">
          <div><dt>档案</dt><dd>{studio.siteUrl.replace(/^https?:\/\//, '')}</dd></div>
          <div>
            <dt>代码</dt>
            <dd><a href="https://github.com/EpochcraftMC" target="_blank" rel="noopener">github.com/EpochcraftMC</a></dd>
          </div>
          <div><dt>成立</dt><dd>{studio.foundedOn}</dd></div>
          <div><dt>天光</dt><dd data-daylight-reading>—</dd></div>
        </dl>
      </div>
    </footer>

    <style>
      .masthead {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgba(8, 7, 4, 0.92);
        backdrop-filter: blur(12px);
      }

      .masthead-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-block: 14px;
      }

      .mark {
        display: flex;
        align-items: baseline;
        gap: 10px;
        min-width: 0;
        text-decoration: none;
      }

      .mark img {
        align-self: center;
        flex-shrink: 0;
        image-rendering: pixelated;
      }

      .mark-zh {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #fff;
        white-space: nowrap;
      }

      .mark-en {
        font-family: var(--font-stamp);
        font-size: 0.5rem;
        letter-spacing: 0.16em;
        color: var(--fg-3);
        white-space: nowrap;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 2px;
      }

      .nav-item {
        display: flex;
        align-items: baseline;
        gap: 6px;
        padding: 5px 9px;
        color: var(--fg-2);
        text-decoration: none;
        transition: color 0.15s ease, background 0.15s ease;
      }

      .nav-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
      }

      .nav-item.is-active {
        color: #fff;
      }

      .nav-item.is-active .nav-code {
        color: var(--mark);
      }

      .nav-code {
        font-family: var(--font-stamp);
        font-size: 0.5rem;
        letter-spacing: 0.1em;
        color: var(--fg-3);
      }

      .nav-label {
        font-size: 0.8125rem;
      }

      .nav-sep {
        width: 1px;
        height: 12px;
        margin-inline: 6px;
        background: var(--rule);
      }

      .section-stamp {
        margin: 0;
        padding-block: 7px;
        font-family: var(--font-data);
        font-size: 0.625rem;
        letter-spacing: 0.18em;
        text-align: right;
        text-transform: uppercase;
        color: var(--fg-3);
      }

      .colophon {
        margin-top: 96px;
      }

      .colophon-inner {
        display: grid;
        gap: 32px;
        padding-block: 40px 56px;
      }

      @media (min-width: 720px) {
        .colophon-inner {
          grid-template-columns: 1fr auto;
        }
      }

      .colophon-body {
        margin: 10px 0 0;
        font-size: 0.8125rem;
        line-height: 1.9;
        color: var(--fg-2);
      }

      .colophon-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin: 14px 0 0;
        font-size: 0.75rem;
      }

      .colophon-links a {
        text-decoration: none;
        color: var(--fg-3);
      }

      .colophon-links a:hover {
        color: var(--mark);
      }

      .colophon-meta {
        display: grid;
        gap: 6px;
        margin: 0;
        font-family: var(--font-data);
        font-size: 0.75rem;
      }

      .colophon-meta div {
        display: flex;
        gap: 16px;
      }

      .colophon-meta dt {
        flex-shrink: 0;
        width: 40px;
        color: var(--fg-3);
      }

      .colophon-meta dd {
        margin: 0;
        color: var(--fg-2);
      }

      .colophon-meta a {
        text-decoration: none;
      }

      .colophon-meta a:hover {
        color: var(--mark);
      }

      @media (max-width: 720px) {
        .mark-en,
        .nav-label {
          display: none;
        }

        .nav-code {
          font-size: 0.56rem;
        }

        .nav-item {
          padding: 5px 7px;
        }
      }
    </style>
  </body>
</html>
